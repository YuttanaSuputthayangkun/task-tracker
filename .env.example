# Copy this file to `.env` and adjust. `.env` is git-ignored; this file is
# committed so everyone can see which settings exist.

# `mode=rwc` = read, write, create the file if it doesn't exist.
DATABASE_URL=sqlite://tasks.db?mode=rwc

# Signs and verifies login tokens. Anyone who knows it can forge a token for
# any user, so use a long random value and never commit the real one.
# Must be at least 32 characters. Generate one in PowerShell with:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# How long a login token stays valid, in minutes.
JWT_TTL_MINUTES=60

PORT=3000

# Comma-separated browser origins allowed to call the API (CORS). Leave empty
# if no browser frontend is calling the API from another origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Log verbosity per crate.
RUST_LOG=task_tracker=debug,tower_http=info
